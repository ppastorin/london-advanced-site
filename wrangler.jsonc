{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "london-advanced-site",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/contact", "/api/subscribe", "/api/loos", "/api/loo-geocode", "/api/charity-shops", "/api/charity-geocode", "/api/search-locations", "/api/decap/auth", "/api/decap/callback", "/api/studio/media/commit", "/api/meteo-dress-products", "/api/meteo-dress-weather"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
